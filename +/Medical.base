filters:
  and:
    - file.hasLink("Atlas/Dots/Medical Information/Medical Conditions")
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasLink("Atlas/Dots/Medical Information/Medical Conditions")
    order:
      - file.name
      - file.path
    sort:
      - property: file.folder
        direction: ASC
  - type: cards
    name: View

filters:
  and:
    - file.folder == "Collections/Movies"
views:
  - type: cards
    name: All Movies
    order:
      - title
      - year
      - writer
      - genres
      - duration
      - director
      - actors
    sort:
      - property: year
        direction: ASC
    image: note.image
    imageFit: contain
    cardSize: 210
  - type: cards
    name: Owned Movies
    filters:
      and:
        - own == true
    order:
      - title
      - year
      - writer
      - genres
      - duration
      - director
      - actors
    sort:
      - property: year
        direction: ASC
    image: note.image
    imageFit: contain
    cardSize: 210

filters:
  and:
    - file.folder == "Collections/Books"
views:
  - type: cards
    name: All Books
    filters:
      and:
        - file.inFolder("Collections")
    groupBy:
      property: title
      direction: ASC
    order:
      - file.name
      - author
      - description
      - publishDate
      - totalPage
      - file.embeds
      - file.links
    sort:
      - property: title
        direction: ASC
    image: note.localCoverImage
    imageFit: contain
    cardSize: 190
  - type: cards
    name: Books Owned
    filters:
      and:
        - owned == true
    order:
      - file.name
      - author
      - description
      - publishDate
      - totalPage
    image: note.localCoverImage
    imageFit: contain
    cardSize: 190
  - type: table
    name: View
